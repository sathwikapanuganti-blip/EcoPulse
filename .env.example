# ========================================================
# EcoPulse Environment Variables Configuration Template
# NOTE: Do NOT commit actual secrets or credentials to GitHub!
# Copy this file to .env and supply your local or production values.
# ========================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
# By default, local dev falls back to embedded H2 database if no MySQL is provided
DB_URL=jdbc:mysql://localhost:3306/ecopulse_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ecopulse_user
DB_PASSWORD=your_secure_mysql_password_here

# JWT Security Key (Must be at least 256 bits long for HMAC-SHA256)
JWT_SECRET=YourSuperSecretKeyForJwtTokenGenerationSecurityKeyMustBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=86400000

# External Environmental Sensor Network
# Open-Meteo Air Quality & Weather API is open and free (no API key required)
AIR_QUALITY_API_KEY=
AIR_QUALITY_API_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# Cache Configuration (Minutes)
CACHE_TTL_MINUTES=15

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
